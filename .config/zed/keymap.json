[
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f r": "file_finder::Toggle", // No equivelent to recent
      "space f b": "git::Branch",
      "space f d": "git_panel::ToggleFocus",
      "space f q": "diagnostics::Deploy",
      "space f p": "pane::DeploySearch",
      "space f w": "outline::Toggle",
      "space f l": "git::Blame",
      "space f /": "pane::DeploySearch",
      "space f s": "pane::DeploySearch",
      "space -": "project_panel::ToggleFocus",
      "space c f": "editor::Format",
      "space c p": "workspace::CopyRelativePath",
      "space shift-d": "diagnostics::Deploy",
      "space g s": "git_panel::ToggleFocus",
      "space g b": "editor::ToggleGitBlameInline",
      "space g shift-b": "git::Blame",
      "space g p": "editor::ToggleSelectedDiffHunks",
      "space g r": "git::Restore",
      "space g d": "git::OpenFileDiff",
      // `] d` / `[ d` are built in and cover all severities
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "] w": ["editor::GoToDiagnostic", { "severity": "warning" }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": "warning" }]
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "space f l": "git::Blame",
      "space f s": "pane::DeploySearch",
      "space c f": "editor::FormatSelections",
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp"
    }
  },
